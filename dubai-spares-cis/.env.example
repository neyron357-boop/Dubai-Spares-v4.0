# Dubai Spares – environment variables
# Copy this file to .env and fill in your Supabase project credentials.
# Get them from: https://supabase.com/dashboard → Project Settings → API

# Project URL  (e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon / public key  (starts with "eyJ…" — NOT "sb_publishable_…")
VITE_SUPABASE_ANON_KEY=

# Optional: override the default storage bucket name (default: images)
# VITE_SUPABASE_STORAGE_BUCKET=images

# Internal API server base URL for server-side features (default: http://localhost:8080)
# VITE_SERVER_API_URL=http://localhost:8080

# Server-only OpenRouter API key for the internal AI core
OPENROUTER_API_KEY=

# Optional: OpenRouter model override (default: openrouter/free)
# OPENROUTER_MODEL=openrouter/free
