create or replace function public.radar_apply_event(p_event_payload jsonb, p_client_event_id text)
returns jsonb
language plpgsql
as $$
declare
  v_session uuid := nullif(p_event_payload->>'radar_session_id', '')::uuid;
  v_target uuid := nullif(p_event_payload->>'target_id', '')::uuid;
  v_target_item uuid := nullif(p_event_payload->>'target_item_id', '')::uuid;
begin
  insert into public.radar_events (
    radar_session_id,
    event_type,
    client_event_id,
    target_id,
    target_item_id,
    shop_id,
    payload
  )
  values (
    v_session,
    coalesce(p_event_payload->>'event_type', 'event'),
    p_client_event_id,
    v_target,
    v_target_item,
    p_event_payload->>'shop_id',
    p_event_payload
  )
  on conflict (client_event_id) do nothing;

  if v_target is not null and p_event_payload ? 'status' then
    update public.radar_targets
    set status = p_event_payload->>'status', updated_at = now()
    where id = v_target;
  end if;

  if v_target_item is not null and p_event_payload ? 'item_status' then
    update public.radar_target_items
    set
      item_status = p_event_payload->>'item_status',
      price_aed = nullif(p_event_payload #>> '{payload,price_aed}', '')::numeric,
      notes = p_event_payload #>> '{payload,notes}',
      updated_at = now()
    where id = v_target_item;
  end if;

  return jsonb_build_object('ok', true);
end;
$$;

create or replace function public.radar_generate_targets(
  p_session_id uuid,
  p_max_targets integer default 30,
  p_user_lat numeric default null,
  p_user_lng numeric default null
)
returns jsonb
language plpgsql
as $$
declare
  inserted_count integer := 0;
begin
  insert into public.radar_targets (
    radar_session_id,
    shop_id,
    score,
    distance_km,
    route_order,
    matched_brands,
    matched_categories
  )
  select
    p_session_id,
    s.id,
    coalesce(s.metrics_heat_level, s.heat_level, 0),
    case
      when p_user_lat is not null and p_user_lng is not null and s.latitude is not null and s.longitude is not null
        then sqrt(power((s.latitude - p_user_lat)::numeric, 2) + power((s.longitude - p_user_lng)::numeric, 2)) * 111.32
      else null
    end,
    row_number() over (order by coalesce(s.metrics_heat_level, s.heat_level, 0) desc),
    coalesce(s.main_brands, '{}'::text[]),
    coalesce(s.specialization_categories, '{}'::text[])
  from public.shops s
  where s.is_active = true
  order by coalesce(s.metrics_heat_level, s.heat_level, 0) desc
  limit greatest(1, coalesce(p_max_targets, 30))
  on conflict (radar_session_id, shop_id) do update
    set score = excluded.score,
        distance_km = excluded.distance_km,
        route_order = excluded.route_order,
        matched_brands = excluded.matched_brands,
        matched_categories = excluded.matched_categories,
        updated_at = now();

  get diagnostics inserted_count = row_count;
  return jsonb_build_object('ok', true, 'count', inserted_count);
end;
$$;

do $$
begin
  if exists (select 1 from information_schema.schemata where schema_name = 'storage') then
    insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
    values
      ('images', 'images', true, 10485760, array['image/jpeg','image/png','image/webp','image/gif']),
      ('order-images', 'order-images', true, 10485760, array['image/jpeg','image/png','image/webp','image/gif'])
    on conflict (id) do update
      set public = excluded.public,
          file_size_limit = excluded.file_size_limit,
          allowed_mime_types = excluded.allowed_mime_types;
  end if;
end $$;

do $$
begin
  if exists (
    select 1
    from information_schema.tables
    where table_schema = 'storage'
      and table_name = 'objects'
  ) then
    execute 'drop policy if exists images_public_select on storage.objects';
    execute 'drop policy if exists images_anon_insert on storage.objects';
    execute 'drop policy if exists images_anon_update on storage.objects';
    execute 'drop policy if exists images_anon_delete on storage.objects';

    execute $policy$
      create policy images_public_select
        on storage.objects for select
        using (bucket_id in ('images', 'order-images'))
    $policy$;

    execute $policy$
      create policy images_anon_insert
        on storage.objects for insert
        with check (bucket_id in ('images', 'order-images'))
    $policy$;

    execute $policy$
      create policy images_anon_update
        on storage.objects for update
        using (bucket_id in ('images', 'order-images'))
        with check (bucket_id in ('images', 'order-images'))
    $policy$;

    execute $policy$
      create policy images_anon_delete
        on storage.objects for delete
        using (bucket_id in ('images', 'order-images'))
    $policy$;
  end if;
end $$;
