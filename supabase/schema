create view public.v_shops_enriched as
select
  s.*,
  coalesce(s.metrics_heat_level, s.heat_level, 0) as metrics_heat_level_safe
from public.shops s
where s.is_active = true;

grant select on public.v_shops_enriched to anon, authenticated;

create view public.v_radar_active_targets as
select
  rt.id,
  rt.radar_session_id,
  rt.shop_id,
  rt.score,
  rt.status,
  rt.distance_km,
  rt.eta_min,
  rt.route_order,
  rt.score_breakdown,
  rt.matched_brands,
  rt.matched_categories,
  rt.created_at,
  rt.updated_at
from public.radar_targets rt
join public.radar_sessions rs on rs.id = rt.radar_session_id
where rs.is_active = true;

